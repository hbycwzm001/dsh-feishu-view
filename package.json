{
  "name": "dsh-feishu-view",
  "version": "0.1.0",
  "description": "飞书顶栏视图：显示飞书接入状态，入口默认隐藏、可在设置里开关（DSH 插件）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.2" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } },
  "private": true,
  "license": "MIT"
}
